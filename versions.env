# Single source of truth for external version pins. See docs/development.md
# "Tested Configurations". Update them locally with scripts/apply-updates.sh
# (KEY="value" per line; data only).
# VSCodium desktop + REH server are one artifact set — one pin.
CODIUM_VERSION="1.143.17232"
CODIUM_COMMIT="c072cf642cbbadabefa22f39c58cc902a8b7427f"   # embedded VS Code commit; names the REH server dir
CODE_VERSION="1.147.0"
REMOTE_SSH_VERSION="0.128.0"        # ms-vscode-remote.remote-ssh (VS Code, marketplace)
OPEN_REMOTE_SSH_VERSION="0.6.2"     # jeanp413.open-remote-ssh (VSCodium, open-vsx)
BASE_IMAGE_DEBIAN="debian:13"      # gen-tested-matrix.sh --write copies this into the init template FROM
BASE_IMAGE_ALPINE="alpine:3.24"     # gen-tested-matrix.sh --write copies this into the tinyproxy FROM
BASE_IMAGE_FEDORA="fedora:45"
