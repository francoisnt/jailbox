OPEN_REMOTE_SSH_VERSION="0.3.1"     # jeanp413.open-remote-ssh (VSCodium, open-vsx)
BASE_IMAGE_DEBIAN="debian:12"
BASE_IMAGE_ALPINE="alpine:3.21"     # container/tinyproxy/Containerfile FROM must match
BASE_IMAGE_FEDORA="fedora:41"
PINS_LAST_VERIFIED="2026-09-22"     # updated by canary bump
