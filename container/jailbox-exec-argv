#!/bin/bash
set -euo pipefail
original_umask=$(umask)
fail() { printf 'Error: invalid jailbox exec frame\n' >&2; exit 2; }
[[ $# = 1 ]] || fail
# Wire limit shared with host/exec.sh; tests/unit/exec.sh checks both boundaries.
[[ -n "$1" && ${#1} -le 49152 && "$1" != *[!A-Za-z0-9+/=]* ]] || fail
[[ "$1" =~ ^([A-Za-z0-9+/]{4})*([A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$ ]] || fail
umask 077
decoded=''
cleanup() {
    [[ -n "$decoded" ]] || return 0
    rm -f -- "$decoded"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
decoded=$(mktemp) || exit 1
printf '%s' "$1" | base64 -d > "$decoded" || fail
args=()
argument=''
while IFS= read -r -d '' argument; do
    args+=("$argument")
done < "$decoded"
# read clears argument on EOF after a delimiter, but retains a truncated tail.
[[ -z "$argument" && ${#args[@]} -gt 0 && -n "${args[0]}" ]] || fail
cleanup || exit 1
trap - EXIT HUP INT TERM
umask "$original_umask"
cd /home/jailbox/project || exit 1
exec -- "${args[@]}"
