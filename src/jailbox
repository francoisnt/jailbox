#!/usr/bin/env bash
if [ "${BASH_VERSINFO[0]}" -lt 4 ] || \
    { [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -lt 4 ]; }; then
    printf 'Error: jailbox requires Bash 4.4 or newer (found %s).\n' \
        "${BASH_VERSION%%(*}" >&2
    printf 'Install it on macOS with: brew install bash\n' >&2
    exit 1
fi
# =============================================================================
# jailbox — Sandboxed AI Development Environment
# =============================================================================
#
# PURPOSE
#   Wraps a project's dev image with SSH access, then launches
#   it as a hardened isolated container. The AI runs inside the same container
#   as the project's dev environment — no bridge, no exec proxy.
#
# CONFIGURATION
#   Machine commands consume JAILBOX_CONFIG_* environment policy. Frontend
#   launches parse jailbox.conf and pass composed policy to public children.
#
# REQUIREMENTS
#   podman, ssh, ssh-keygen; bare launch also requires VSCodium/VSCode with
#   the open-remote-ssh extension
# =============================================================================
set -euo pipefail

resolve_script_path() {
    local source dir target

    source="${BASH_SOURCE[0]}"
    while [ -L "$source" ]; do
        dir="$(cd -P "$(dirname "$source")" && pwd)"
        target="$(readlink "$source")"
        case "$target" in
            /*) source="$target" ;;
            *) source="$dir/$target" ;;
        esac
    done

    cd -P "$(dirname "$source")" && pwd
}

SCRIPT_DIR="$(resolve_script_path)"
PROJECT_DIR=$(pwd -P)
CONFIG_PATH_ARG=""

# shellcheck source=src/public-api.sh
source "$SCRIPT_DIR/public-api.sh"
# shellcheck source=src/host/api-support.sh
source "$SCRIPT_DIR/host/api-support.sh"
initialize_public_api_lookups
# shellcheck source=src/host/cli.sh
source "$SCRIPT_DIR/host/cli.sh"

run_uninstall() {
    # Delegate to the installer copy shipped inside this install, so the
    # uninstall logic always matches the installed version's layout.
    [ -f "$SCRIPT_DIR/.jailbox-install" ] || \
        { echo "Error: this jailbox is not an installed copy (source checkout?); nothing to uninstall" >&2; return 1; }
    # exec: install.sh deletes SCRIPT_DIR, so this script must not keep
    # running (bash reads scripts incrementally from disk).
    JAILBOX_INSTALL_DIR="$SCRIPT_DIR" exec bash "$SCRIPT_DIR/install.sh" --uninstall
}

main() {
    local option handler
    local -A seen_options=()
    validate_cli_implementation
    while [[ "${1:-}" =~ ^-{0,2}[A-Za-z][A-Za-z0-9-]*$ && -n "${CLI_OPTION_TARGETS[${1:-}]-}" ]]; do
        option="$1"
        [[ ! -v seen_options[$option] ]] || { echo "Error: repeated option: $option" >&2; exit 2; }
        seen_options["$option"]=1
        if [[ -z "${2:-}" ]] || { [[ "$2" = -* ]] && is_cli_flag_allowed "$2"; }; then
            echo "Error: $option requires a ${CLI_VALUE_NAMES[$option]} value" >&2
            usage >&2
            exit 2
        fi
        printf -v "${CLI_OPTION_TARGETS[$option]}" '%s' "$2"
        shift 2
    done

    parse_args "$@"
    case "${1:-}" in
        ''|--no-editor|validate) ;;
        *) [[ -z "$CONFIG_PATH_ARG" ]] || { echo "Error: --config cannot be used with ${1:-}" >&2; exit 2; } ;;
    esac
    case "${1:-}" in
        ''|--no-editor|init)
            # shellcheck source=src/host/frontend/entry.sh
            source "$SCRIPT_DIR/host/frontend/entry.sh"
            ;;
        validate)
            if [[ -n "$CONFIG_PATH_ARG" ]]; then
                # shellcheck source=src/host/frontend/entry.sh
                source "$SCRIPT_DIR/host/frontend/entry.sh"
            else
                # shellcheck source=src/host/core/entry.sh
                source "$SCRIPT_DIR/host/core/entry.sh"
            fi
            ;;
        config-schema)
            # shellcheck source=src/host/core/commands/config-schema.sh
            source "$SCRIPT_DIR/host/core/commands/config-schema.sh"
            ;;
        --help|--uninstall) ;;
        *)
            # shellcheck source=src/host/core/entry.sh
            source "$SCRIPT_DIR/host/core/entry.sh" ;;
    esac
    if [[ -z "${1:-}" ]]; then
        run_launch
    else
        handler=${CLI_COMMAND_HANDLERS[$1]}
        shift
        declare -F "$handler" >/dev/null || public_api_error "missing command handler '$handler'"
        "$handler" "$@"
    fi
}

main "$@"
