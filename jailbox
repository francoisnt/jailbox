#!/usr/bin/env bash
if [ "${BASH_VERSINFO[0]}" -lt 4 ] || \
    { [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -lt 4 ]; }; then
    printf 'Error: jailbox requires Bash 4.4 or newer (found %s).\n' \
        "${BASH_VERSION%%(*}" >&2
    printf 'Install it on macOS with: brew install bash\n' >&2
    exit 1
fi
# =============================================================================
# jailbox — Sandboxed AI Development Environment
# =============================================================================
#
# PURPOSE
#   Wraps a project's dev image with SSH access, then launches
#   it as a hardened isolated container. The AI runs inside the same container
#   as the project's dev environment — no bridge, no exec proxy.
#
# CONFIGURATION
#   jailbox.conf in the project root is parsed if present. Supported settings:
#     DEV_IMAGE, DEV_CONTAINERFILE, DEV_BUILD_CONTEXT, DEV_TARGET_STAGE,
#     EDITOR, EGRESS_ALLOW, READONLY_PATHS.
#
# REQUIREMENTS
#   podman, ssh, ssh-keygen, VSCodium/VSCode with open-remote-ssh extension
# =============================================================================
set -euo pipefail

resolve_script_path() {
    local source dir target

    source="${BASH_SOURCE[0]}"
    while [ -L "$source" ]; do
        dir="$(cd -P "$(dirname "$source")" && pwd)"
        target="$(readlink "$source")"
        case "$target" in
            /*) source="$target" ;;
            *) source="$dir/$target" ;;
        esac
    done

    cd -P "$(dirname "$source")" && pwd
}

SCRIPT_DIR="$(resolve_script_path)"
PROJECT_DIR=$(pwd -P)

# shellcheck source=host/public-api.sh
source "$SCRIPT_DIR/host/public-api.sh"
# Defaults overridden by jailbox.conf
apply_config_defaults
# shellcheck source=host/common.sh
source "$SCRIPT_DIR/host/common.sh"
# shellcheck source=host/preflight.sh
source "$SCRIPT_DIR/host/preflight.sh"
# shellcheck source=host/dev-image.sh
source "$SCRIPT_DIR/host/dev-image.sh"
# shellcheck source=host/ssh.sh
source "$SCRIPT_DIR/host/ssh.sh"
# shellcheck source=host/network.sh
source "$SCRIPT_DIR/host/network.sh"
# shellcheck source=host/downloader-proxy.sh
source "$SCRIPT_DIR/host/downloader-proxy.sh"
# shellcheck source=host/editor.sh
source "$SCRIPT_DIR/host/editor.sh"
# shellcheck source=host/container-runtime.sh
source "$SCRIPT_DIR/host/container-runtime.sh"
# shellcheck source=host/validation.sh
source "$SCRIPT_DIR/host/validation.sh"

run_launch() {
    initialize_runtime_ids
    validate_configured_readonly_paths
    check_local_port_available
    build_or_select_dev_image
    finalize_effective_readonly_paths
    validate_dev_image
    warn_if_alpine_dev_image_with_vscode
    build_jailbox_image
    configure_runtime_mounts
    configure_network
    setup_ssh_keys
    build_readonly_mounts
    ensure_home_volume
    start_jailbox_container
    pin_ssh_host_key
    wait_for_ssh
    configure_downloader_proxy
    post_start_validation
    open_editor
}

run_doctor() {
    initialize_runtime_ids
    doctor_jailbox
}

run_ssh_config() {
    initialize_runtime_ids
    if [ -n "${EGRESS_ALLOW[*]-}" ]; then
        configure_proxy_env
    fi
    print_ssh_config_instructions
}

run_clean() {
    clean_jailbox
}

run_uninstall() {
    # Delegate to the installer copy shipped inside this install, so the
    # uninstall logic always matches the installed version's layout.
    [ -f "$SCRIPT_DIR/.jailbox-install" ] || \
        die "this jailbox is not an installed copy (source checkout?); nothing to uninstall"
    # exec: install.sh deletes SCRIPT_DIR, so this script must not keep
    # running (bash reads scripts incrementally from disk).
    JAILBOX_INSTALL_DIR="$SCRIPT_DIR" exec bash "$SCRIPT_DIR/install.sh" --uninstall
}

initialize_launch_state() {
    initialize_project_names
    initialize_dev_image_state
    initialize_ssh_state
    initialize_editor_state
    initialize_network_state
    initialize_container_runtime_state
}

main() {
    CONFIG_PATH_ARG=""
    if [ "${1:-}" = "--config" ]; then
        case "${2:-}" in
            ""|--help|--config)
                echo "Error: --config requires a PATH value" >&2
                usage >&2
                exit 2
                ;;
        esac
        CONFIG_PATH_ARG="$2"
        shift 2
    fi

    parse_args "$@"

    # Uninstall delegates to the installed copy and must not inspect project
    # configuration or require any launch dependency.
    if [[ "${1:-}" == "--uninstall" ]]; then
        run_uninstall
    fi

    prepare_config_selection
    load_project_config

    host_preflight "$@"
    initialize_launch_state

    case "${1:-}" in
        doctor)
            run_doctor
            ;;
        ssh-config)
            run_ssh_config
            ;;
        --clean)
            run_clean
            ;;
        *)
            run_launch
            ;;
    esac
}

main "$@"
