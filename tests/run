#!/bin/bash
# Run jailbox's test gates.
#
# Usage: tests/run [dev [SUITE ...]|portable|runtime|matrix|editor]
#
#   dev       Fast development checks, plus explicitly named unit suites
#   portable  ShellCheck, unit tests, and distribution/install lifecycle
#   runtime   Container security contract and headless CLI system tests
#   matrix    Full lifecycle state and interruption matrix
#   editor    Real VS Code/VSCodium Remote SSH and task execution
#
# Naming no gate runs all four in order. Prerequisites for every selected gate
# are checked before any suite runs, so a missing dependency fails immediately
# instead of after a long gate.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JAILBOX_DIR="$(dirname "$SCRIPT_DIR")"
# shellcheck source=tests/lib/logging.sh
source "$SCRIPT_DIR/lib/logging.sh"

ALL_GATES=(portable runtime matrix editor)

SUITES_PASSED=0
SUITES_FAILED=0
SELECTED_EDITOR=""
DEV_SUITES=()

die() { echo "Error: $*" >&2; exit 1; }

have_display() {
    [[ "$(uname -s)" == "Darwin" ]] && return 0
    [[ -n "${DISPLAY:-}" || -n "${WAYLAND_DISPLAY:-}" ]]
}

selected_editor() {
    case "${JAILBOX_EDITOR:-}" in
        codium|code) printf '%s\n' "$JAILBOX_EDITOR" ;;
        "")
            if command -v codium >/dev/null 2>&1; then
                printf 'codium\n'
            else
                printf 'code\n'
            fi
            ;;
        *) die "invalid JAILBOX_EDITOR='$JAILBOX_EDITOR' (expected codium or code)" ;;
    esac
}

rerun_with_xvfb_if_needed() {
    [[ "$(uname -s)" == "Linux" ]] || return 1
    [[ "${JAILBOX_UNDER_XVFB:-}" != "1" ]] || return 1
    command -v xvfb-run >/dev/null 2>&1 || return 1

    JAILBOX_UNDER_XVFB=1 exec xvfb-run -a bash "$0" "$@"
}

suite_pass() {
    test_log_result PASS "$GATE/$1" "${2:-0}"
    SUITES_PASSED=$((SUITES_PASSED + 1))
}

suite_fail() {
    test_log_result FAIL "$GATE/$1" "${2:-0}"
    SUITES_FAILED=$((SUITES_FAILED + 1))
}

run_suite() {
    local label="$1" started=$SECONDS
    shift

    printf 'RUN   %s\n' "$label"
    if "$@"; then
        suite_pass "$label" "$((SECONDS - started))"
    else
        suite_fail "$label" "$((SECONDS - started))"
        print_summary
        exit 1
    fi
}

run_unit_suites() {
    # shellcheck source=tests/lib/portable-pool.sh
    source "$SCRIPT_DIR/lib/portable-pool.sh"
    run_portable_unit_suites "${DEV_SUITES[@]}"
}

print_summary() {
    echo ""
    printf 'Gate %s: %d suite(s) passed' "$GATE" "$SUITES_PASSED"
    [[ "$SUITES_FAILED" -gt 0 ]] && printf ', %d failed' "$SUITES_FAILED"
    printf '\n'
    if [[ "$GATE" = dev && "$SUITES_FAILED" = 0 ]]; then
        printf 'Development checks passed — partial coverage (full portable still required).\n'
    fi
    printf 'Elapsed gate %s: %ds\n' "$GATE" "$((SECONDS - GATE_STARTED))"
    if [[ ${GITHUB_ACTIONS:-false} = true && -n ${GITHUB_STEP_SUMMARY:-} && ${JAILBOX_TEST_LOG_SCRIPT:-} = "$SCRIPT_DIR/run" ]]; then
        printf '| %s | %s | %s | %ss |\n' "$GATE" "$SUITES_PASSED" "$SUITES_FAILED" "$((SECONDS - GATE_STARTED))" >> "$GITHUB_STEP_SUMMARY"
    fi
}

gate_selected() {
    local gate

    for gate in "${GATES[@]}"; do
        if [[ "$gate" == "$1" ]]; then
            return 0
        fi
    done
    return 1
}

# Refuse a run that cannot finish before spending time on its first gate. The
# editor gate's display requirement is met by re-executing the whole run under
# xvfb-run, so an all-gates run stays one process with one report.
require_gate_prerequisites() {
    command -v python3 >/dev/null 2>&1 || die "python3 is required for test gates"
    if gate_selected portable; then
        command -v shellcheck >/dev/null 2>&1 || die "shellcheck is required for the portable gate"
    fi
    if gate_selected runtime; then
        command -v podman >/dev/null 2>&1 || die "podman is required for the runtime gate"
    fi
    if gate_selected matrix; then
        [[ $(uname -s) = Linux ]] || die "Linux is required for the matrix gate"
        local tool
        for tool in podman setsid ssh ssh-keygen git; do
            command -v "$tool" >/dev/null 2>&1 || die "$tool is required for the matrix gate"
        done
    fi
    if gate_selected editor; then
        command -v podman >/dev/null 2>&1 || die "podman is required for the editor gate"
        # Resolve the editor here rather than in the gate: an override naming an
        # uninstalled editor must fail before the earlier gates run, and
        # selected_editor also rejects an override that names neither editor.
        SELECTED_EDITOR="$(selected_editor)"
        if ! command -v "$SELECTED_EDITOR" >/dev/null 2>&1; then
            [[ -z "${JAILBOX_EDITOR:-}" ]] || \
                die "JAILBOX_EDITOR=$SELECTED_EDITOR selects an editor that is not installed"
            die "VSCodium or VS Code CLI is required for the editor gate"
        fi
        # rerun_with_xvfb_if_needed either execs or reports that it cannot.
        if ! have_display; then
            rerun_with_xvfb_if_needed "$@" || \
                die "a graphical display session or xvfb-run is required for the editor gate"
        fi
    fi
}

check_generated_files() {
    bash "$JAILBOX_DIR/scripts/gen-tested-matrix.sh" --check || return $?
    bash "$JAILBOX_DIR/scripts/gen-public-api.sh" --check
}

run_gate() {
    local -a editor_stages

    case "$1" in
        dev)
            run_suite "syntax" bash "$SCRIPT_DIR/portable/syntax.sh"
            run_suite "generated-files" check_generated_files
            run_unit_suites
            ;;
        portable)
            run_suite "shellcheck" bash "$JAILBOX_DIR/scripts/lint.sh"
            run_suite "generated-files" check_generated_files
            run_unit_suites
            run_suite "distribution" bash "$SCRIPT_DIR/portable/smoke.sh"
            ;;
        runtime)
            run_suite "container-contract" bash "$SCRIPT_DIR/integration/wrapper-images.sh"
            run_suite "system/headless" bash "$SCRIPT_DIR/e2e/headless.sh"
            ;;
        matrix)
            run_suite "wrapper-image-preparation" bash "$SCRIPT_DIR/integration/wrapper-images.sh" --prepare-only debian
            run_suite "lifecycle-state" bash "$SCRIPT_DIR/integration/lifecycle-state.sh"
            ;;
        editor)
            # Runtime owns the editor-independent security contract. Prepare only
            # the positive images this editor consumes on its isolated test host.
            if [[ "$SELECTED_EDITOR" == codium ]]; then
                editor_stages=(debian alpine fedora)
            else
                editor_stages=(debian fedora)
            fi
            run_suite "wrapper-image-preparation" \
                bash "$SCRIPT_DIR/integration/wrapper-images.sh" --prepare-only "${editor_stages[@]}"
            run_suite "system/editor" bash "$SCRIPT_DIR/e2e/editor-smoke.sh"
            ;;
    esac
}

usage() {
    cat <<EOF
Usage: $(basename "$0") [dev [SUITE ...]|portable|runtime|matrix|editor]

Runs every gate in order when no gate is named.
Runtime and matrix are independent gates; matrix prepares its own required images.

Development checks:
  dev [SUITE ...]  Syntax, generated files, fast suites, plus named unit suites
                  Partial coverage; omits full ShellCheck and distribution

Test gates:
  portable  ShellCheck, all unit tests, release tarball, and install lifecycle
  runtime   Wrapper/container security contract and headless jailbox CLI system tests
  matrix    Full lifecycle state and interruption matrix with required image preparation
  editor    Build test images and verify a real Remote SSH editor session and task
EOF
}

if [[ ${1:-} = dev ]]; then
    GATES=(dev)
    shift
    for suite in "$@"; do
        suite=${suite%.sh}
        [[ "$suite" =~ ^[a-z0-9-]+$ && -f "$SCRIPT_DIR/unit/$suite.sh" ]] || die "unknown unit suite: $suite"
        DEV_SUITES+=("$suite.sh")
    done
    # Preserve the complete invocation when logging re-executes the entrypoint.
    set -- dev "${DEV_SUITES[@]}"
else
    case "$#" in
        0) GATES=("${ALL_GATES[@]}") ;;
        1)
            case "$1" in
                portable|runtime|matrix|editor) GATES=("$1") ;;
                --help|-h) usage; exit 0 ;;
                *) die "unknown test gate: $1 (expected dev, portable, runtime, matrix, or editor)" ;;
            esac
            ;;
        *) usage >&2; exit 2 ;;
    esac
fi

# Help and argument validation finish before timestamped execution begins.
test_log_entrypoint "$SCRIPT_DIR/run" "$@"
require_gate_prerequisites "$@"
TZ=UTC printf 'jailbox tests · %(%Y-%m-%d)T · UTC\n' -1
if [[ ${GITHUB_ACTIONS:-false} = true && -n ${GITHUB_STEP_SUMMARY:-} && ${JAILBOX_TEST_LOG_SCRIPT:-} = "$SCRIPT_DIR/run" ]]; then
    printf '| Gate | Suites passed | Suites failed | Elapsed |\n| --- | ---: | ---: | ---: |\n' >> "$GITHUB_STEP_SUMMARY"
fi

FIRST_GATE=true
for GATE in "${GATES[@]}"; do
    if [[ "$FIRST_GATE" == true ]]; then
        FIRST_GATE=false
    else
        echo ""
    fi
    SUITES_PASSED=0
    SUITES_FAILED=0
    GATE_STARTED=$SECONDS
    export JAILBOX_TEST_GATE="$GATE"
    echo "jailbox test gate: $GATE"
    echo "Working directory: $JAILBOX_DIR"
    run_gate "$GATE"
    print_summary
done

if [[ "${#GATES[@]}" -gt 1 ]]; then
    printf '\nAll gates passed: %s\n' "${GATES[*]}"
fi

[[ "$SUITES_FAILED" -eq 0 ]]
